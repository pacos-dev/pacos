pipeline {
    agent any

    tools {
        git 'Default'
        maven 'mvn'
        jdk 'jdk21'
    }

    stages {
        stage('Build & Deploy') {
            steps {
                configFileProvider([configFile(fileId: 'pacos-repo', targetLocation: 'settings.xml')]) {
                    sh """
                        mvn -U clean deploy \
                        -DworkingDir=./pacos \
                        -Dlogback.configurationFile=src/test/resources/logback-test.xml \
                        -Pproduction \
                        -s settings.xml
                    """
                }
            }
        }
    }

    post {
        failure {
            echo "Deployment failed on branch ${env.BRANCH_NAME}"
        }
        success {
            echo "Build and deployment completed on branch ${env.BRANCH_NAME}"
        }
    }
}
