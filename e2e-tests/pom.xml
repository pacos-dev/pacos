<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.pacos</groupId>
        <artifactId>pacos</artifactId>
        <version>3.5.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>pacos-e2e-tests</artifactId>
    <name>PacOS end-to-end tests</name>
    <packaging>jar</packaging>

    <properties>
        <playwright.version>1.56.0</playwright.version>
        <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
        <pacos.e2e.skip>true</pacos.e2e.skip>
        <!-- Keep browser-driven E2E tests out of SonarQube analysis. -->
        <sonar.skip>true</sonar.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.pacos</groupId>
            <artifactId>engine</artifactId>
            <version>25.3.3</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <skipTests>${pacos.e2e.skip}</skipTests>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
        </plugins>
    </build>
</project>
